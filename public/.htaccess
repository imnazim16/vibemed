# Apache configuration for Hostinger (vibemed.vibbevital.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward all API calls to the PHP reverse proxy (bypasses browser CORS completely)
  RewriteRule ^api/v1(/.*)?$ api/proxy.php$1 [QSA,L]

  # 2. Allow direct access to existing files and directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Fallback: Route all non-file browser requests to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Caching & MIME types
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

# Pass Authorization header to PHP
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Authorization "Bearer (.*)" HTTP_AUTHORIZATION=Bearer\ $1
</IfModule>
